geom_line(data = long_data_tally1, aes(x = `Time (minutes)`, y = O2), color = "black", linewidth = 1) +
geom_point(data = long_data_tally1, aes(x = `Time (minutes)`, y = O2), color = "black", size = 2) +
# 3. Apply custom colors and theme
# scale_fill_manual(values = c("Phase A" = "#E69F00", "Phase B" = "#56B4E9", "Phase C" = "#009E73")) +
theme_minimal() +
labs(title = "25C mitochondria stress test", x = "Time (minutes)", y = "O2", fill = "Paradigm") +
theme_classic()
# 3. Reshape from wide to long and create a tally column
long_data <- seahorse_25C.clean %>%
tidyr::pivot_longer(
cols = starts_with(c("2", "3")),
names_to = "Family_ID",
values_to = "O2"
) %>%
# Create a sequence tally for each repeated group
group_by(paradigm, `Time (minutes)`) %>%
mutate(tally = dplyr::row_number(),
Family_ID = sub("\\..*", "", Family_ID)) %>%
dplyr::ungroup()
# test figures
long_data_tally1 <- long_data %>% dplyr::filter(tally == 6)
# Find the start and end for each interval block
rects <- long_data_tally1 %>%
group_by(paradigm) %>%
dplyr::summarize(
start = min(`Time (minutes)`),
end = max(`Time (minutes)`)
)
ggplot() +
# 1. Add background shading
geom_rect(data = rects,
aes(xmin = start - 0.5, xmax = end + 0.5,
ymin = -Inf, ymax = Inf, fill = paradigm),
alpha = 0.3) +
# 2. Add time series line and points
geom_line(data = long_data_tally1, aes(x = `Time (minutes)`, y = O2), color = "black", linewidth = 1) +
geom_point(data = long_data_tally1, aes(x = `Time (minutes)`, y = O2), color = "black", size = 2) +
# 3. Apply custom colors and theme
# scale_fill_manual(values = c("Phase A" = "#E69F00", "Phase B" = "#56B4E9", "Phase C" = "#009E73")) +
theme_minimal() +
labs(title = "25C mitochondria stress test", x = "Time (minutes)", y = "O2", fill = "Paradigm") +
theme_classic()
