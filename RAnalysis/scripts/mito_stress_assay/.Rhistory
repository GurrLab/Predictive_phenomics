long_data_25C
# 3. Reshape from wide to long and create a tally column
long_data_25C <- seahorse_25C.clean %>%
tidyr::pivot_longer(
cols = starts_with(c("2", "3")),
names_to = "Family_ID",
values_to = "O2"
) %>%
dplyr::rename(Time_min = `Time (minutes)`) %>%
# Create a sequence tally for each repeated group
group_by(paradigm, Time_min) %>%
mutate(tally = dplyr::row_number(),
Family_ID = sub("\\..*", "", Family_ID)) %>%
dplyr::ungroup()
long_data_25C
long_data_34C <- long_data_34C %>% dplyr::filter(!Family_ID %in% "251") # the only family that does not have any viable data at 25C, omit for comarison
long_data_34C$O2       <- as.numeric(long_data_34C$O2)
long_data_34C$Time_min <- as.numeric(long_data_34C$Time_min)
long_data_34C_MeanSE <- Rmisc::summarySE(long_data_34C, measurevar = "O2", groupvars = c("Time_min", "paradigm", "Family_ID"))
# 3. Reshape from wide to long and create a tally column
long_data_25C.clean <- seahorse_25C.clean %>%
tidyr::pivot_longer(
cols = starts_with(c("2", "3")),
names_to = "Family_ID",
values_to = "O2"
) %>%
# Create a sequence tally for each repeated group
group_by(paradigm, `Time (minutes)`) %>%
mutate(tally = dplyr::row_number(),
Family_ID = sub("\\..*", "", Family_ID)) %>%
dplyr::ungroup()
# 3. Reshape from wide to long and create a tally column
long_data_34C.clean <- seahorse_34C.clean %>%
tidyr::pivot_longer(
cols = starts_with(c("2", "3")),
names_to = "Family_ID",
values_to = "O2"
) %>%
# Create a sequence tally for each repeated group
group_by(paradigm, `Time (minutes)`) %>%
mutate(tally = dplyr::row_number(),
Family_ID = sub("\\..*", "", Family_ID)) %>%
dplyr::ungroup()
long_data_34C.clean <- long_data_34C.clean %>% dplyr::filter(!Family_ID %in% "251") # the only family that does not have any viable data at 25C, omit for comarison
long_data_34C.clean
long_data_25C.clean$`Time (minutes)` = as.numeric(long_data_25C.clean$`Time (minutes)`)
long_data_25C.clean$O2 = as.numeric(long_data_25C.clean$O2)
Baseline_25C = long_data_25C.clean %>%
dplyr::filter(`Time (minutes)` > 49 & `Time (minutes)` < 68)
Oligo_25C = long_data_25C.clean %>%
dplyr::filter(`Time (minutes)` > 160 & `Time (minutes)` < 178 )
MaxResp_25C = long_data_25C.clean %>%
dplyr::filter(`Time (minutes)` > 187 & `Time (minutes)` < 208 )
NonMito_25C = long_data_25C.clean %>%
dplyr::filter(`Time (minutes)` > 258 & `Time (minutes)` < 280)
CalcMaster_25C <- rbind(Baseline_25C,
Oligo_25C,
MaxResp_25C,
NonMito_25C) %>%
dplyr::group_by(paradigm, Family_ID, tally) %>%
dplyr::summarise(
meanO2 = mean(O2, na.rm = TRUE),
seO2  = sd(O2, na.rm = TRUE) / sqrt(dplyr::n()),
n = dplyr::n(),
.groups  = "drop"
)
CalcMaster_25C
CalcMaster_25C.final <- CalcMaster_25C %>%
dplyr::select(-c(seO2, n)) %>%
tidyr::pivot_wider(
names_from = paradigm,    # Column containing names for the new columns
values_from = meanO2     # Column containing values to fill the cells
) %>%
dplyr::mutate(
SpareCapacity = (`FCCP 2uM`) - (Baseline),
ATPLinked     = (`Oligo 10uM`) - (Baseline),
ProtonLeak    = (`Oligo 10uM`) - (`AA/Rot 12/6uM`)
) %>%
dplyr::rename(
MaxResp = `FCCP 2uM`,
Oligo = `Oligo 10uM`,
NonMitoResp = `AA/Rot 12/6uM`
) %>%
tidyr::pivot_longer(
cols = -c(Family_ID, tally),
names_to = "Metric",    # Column containing names for the new columns
values_to = "O2"     # Column containing values to fill the cells
) %>%
dplyr::mutate(Temperature = "25 Celcius")
CalcMaster_25C.final
# FULL NUMERICAL DATASET
