#     aes(x = Time_min, ymin = se, ymax = se),
#     width = 0.2, linewidth = 1, group = "Family_ID"
#   ) +
#   # Formatting and labels
#   theme_classic()
Plot_MEANSe_34C <- ggplot(long_data_34C, aes(x = Time_min,
y = O2,
colour = Family_ID,
group = Family_ID)) +
stat_summary(fun = mean, geom = "line") +
stat_summary(fun = mean, geom = "point", size = 2) +
stat_summary(fun.data = mean_se, geom = "errorbar", width = 0.1) +
scale_x_continuous(breaks = seq(0, 300, by = 25)) +
theme_bw()
seahorse_34C.clean
# 3. Reshape from wide to long and create a tally column
long_data_25C.clean <- seahorse_25C.clean %>%
tidyr::pivot_longer(
cols = starts_with(c("2", "3")),
names_to = "Family_ID",
values_to = "O2"
) %>%
# Create a sequence tally for each repeated group
group_by(paradigm, `Time (minutes)`) %>%
mutate(tally = dplyr::row_number(),
Family_ID = sub("\\..*", "", Family_ID)) %>%
dplyr::ungroup()
# 3. Reshape from wide to long and create a tally column
long_data_34C.clean <- seahorse_34C.clean %>%
tidyr::pivot_longer(
cols = starts_with(c("2", "3")),
names_to = "Family_ID",
values_to = "O2"
) %>%
# Create a sequence tally for each repeated group
group_by(paradigm, `Time (minutes)`) %>%
mutate(tally = dplyr::row_number(),
Family_ID = sub("\\..*", "", Family_ID)) %>%
dplyr::ungroup()
long_data_34C.clean <- long_data_34C.clean %>% dplyr::filter(!Family_ID %in% "251") # the only family that does not have any viable data at 25C, omit for comarison
Plot_MEANSe_34C <- ggplot(long_data_34C, aes(x = Time_min,
y = O2,
colour = Family_ID,
group = Family_ID)) +
stat_summary(fun = mean, geom = "line") +
stat_summary(fun = mean, geom = "point", size = 2) +
stat_summary(fun.data = mean_se, geom = "errorbar", width = 0.1) +
scale_x_continuous(breaks = seq(0, 300, by = 25)) +
theme_bw()
ggarrange(
Plot_MEANSe_25C,
Plot_MEANSe_34C,
nrow = 2
)
